{
  "name": "npm-supply-chain-guard",
  "version": "2.0.0",
  "private": true,
  "description": "Prevention-first protection against npm supply chain attacks. Uses pnpm deny-by-default scripts, package age gating, and extensible blocklist.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "preinstall": "bash scripts/npm-security-guard.sh",
    "postinstall": "bash scripts/npm-security-guard.sh",
    "prepare": "bash scripts/install-git-hooks.sh",
    "security:check": "bash scripts/npm-security-guard.sh",
    "security:audit": "pnpm audit --audit-level=critical"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0"
}
