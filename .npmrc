# Security: enforce audit on every npm install (npm-specific; pnpm uses explicit pnpm audit)
audit=true
audit-level=critical

# pnpm handles minimumReleaseAge, onlyBuiltDependenciesFile, and blockExoticSubdeps
# via pnpm-workspace.yaml — those settings are not duplicated here.

# Known-malicious packages (axios supply chain attack 2026-03-30)
# Reactive blocklist enforced by scripts/npm-security-guard.sh and CI workflow.
# pnpm's deny-by-default scripts + minimumReleaseAge provide proactive defense.
# - plain-crypto-js — RAT payload injected via compromised axios@1.14.1
# - If axios is ever needed, prefer native fetch() (Node.js 18+) or pin to a verified safe version.
